{
  "name": "custom-hocalwire-cms",
  "version": "1.4.1",
  "private": true,
  "description": "Custom self-hosted headless CMS monorepo",
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "gen:block": "pnpm --filter @cms/theme-kit gen:block --",
    "gen:template": "pnpm --filter @cms/theme-kit gen:template --",
    "verify:theme": "pnpm --filter @cms/theme-kit verify && pnpm --filter @cms/api verify:fixtures",
    "verify:theme:structure": "pnpm --filter @cms/theme-kit verify",
    "verify:theme:content": "pnpm --filter @cms/api verify:fixtures",
    "check:theme-scope": "node scripts/check-theme-scope.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "dev:services": "docker compose up -d postgres pgbouncer dragonfly meilisearch minio minio-setup",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @cms/e2e test",
    "test:e2e:ui": "pnpm --filter @cms/e2e test:ui",
    "export:starter": "node scripts/export-starter.mjs",
    "export:clone": "node scripts/export-starter.mjs --with-data",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^7.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vue-eslint-parser": "^10.4.0"
  }
}
