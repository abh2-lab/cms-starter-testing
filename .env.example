# Copy this file to .env and adjust values for your environment.
# packages/config will validate these on startup — missing/invalid vars fail hard.
#
# ─── Two ways to get a working .env ─────────────────────────────────────────────
#   1. Hybrid dev (you edit source + run `pnpm dev`):
#      `cp .env.example .env`, then edit. Defaults below assume backing
#      services on host ports from docker-compose.override.yml.
#
#   2. Fresh-install starter zip (`pnpm export:starter`):
#      The export script generates `.env` automatically inside cms-starter.zip
#      with random PREVIEW_TOKEN_SECRET and WEBHOOK_SECRET_ENCRYPTION_KEY
#      (64-hex, different every export), plus dockerized-stack defaults for
#      everything else. The recipient runs `docker compose up -d --build` and
#      hits the setup wizard — no .env editing required.
#      See README.md → "Producing a starter zip" and scripts/export-starter.mjs.
# ────────────────────────────────────────────────────────────────────────────────

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# Listen ports (API=3000, Worker=3100, Web=3001) and bind hosts have working
# defaults from packages/config + the app Dockerfiles. They're never an
# operator concern: Coolify routes by Traefik UI config, container-to-container
# uses `http://<service>:<port>` over the compose network. Don't add them here.

# ─── Database ──────────────────────────────────────────────────────────────────
# Single connection string. Username, password, host, and database are all inside.
# Local dev: points at PgBouncer (transaction pooling) on :6432, fronting Postgres.
# Production: replace with your own pooled connection string from the operator.
DATABASE_URL=postgres://postgres:postgres@localhost:6432/cms

# Direct (non-pooled) Postgres connection for migrations and other operations
# that PgBouncer in transaction mode can't safely handle (DDL, advisory locks,
# LISTEN/NOTIFY). Only required when running `drizzle-kit`; runtime code uses
# DATABASE_URL. Points at Postgres directly on :5432, bypassing PgBouncer.
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cms

# ─── Cache + Queue backend (DragonflyDB, Redis-compatible) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Search (Meilisearch) ──────────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
# Leave empty in development. REQUIRED in production — Meilisearch refuses to start
# in MEILI_ENV=production without it.
MEILI_MASTER_KEY=

# ─── Object storage (S3-compatible: MinIO in dev, Garage/AWS in prod) ───────────
# Defaults match the MinIO service in docker-compose.yml. Override in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO/Garage require path-style addressing ("true"). AWS S3 can use "false".
S3_FORCE_PATH_STYLE=true
# Optional CDN/public base URL for objects. Leave empty to use presigned GET URLs.
S3_PUBLIC_URL=
# Public HTTPS endpoint of the S3 API, used to sign browser-facing upload and
# download URLs. Leave empty in local dev (the browser reaches MinIO directly on
# localhost:9000). In a containerized prod deploy the API's S3_ENDPOINT is an
# internal hostname (http://minio:9000) the browser can't reach — set this to
# MinIO's public URL so presigned URLs are browser-usable, e.g.
#   S3_PUBLIC_ENDPOINT=https://minio.example.com
S3_PUBLIC_ENDPOINT=

# ─── Preview ───────────────────────────────────────────────────────────────────
# Public Nuxt site base URL. The admin "Preview" button opens a new tab against
# this host, passing a short-lived signed token.
# PUBLIC_WEB_URL was removed — the public site URL now lives in
# siteSettings.siteUrl (admin → Site Settings) and is the single source of
# truth for the admin's "Preview" buttons + outbound email links.

# CORS_ALLOWED_ORIGINS is intentionally omitted — admin + web both proxy /api
# same-origin (admin via nginx, web via Nitro route rule), so the API never sees
# a cross-origin browser request from them. Only set it if you have a SEPARATE
# browser client hitting /api/v1 cross-origin.

# HMAC secret for preview tokens. Override per deployment. Must be ≥32 chars in
# NODE_ENV=production. Rotating this immediately invalidates every outstanding
# preview link (no DB lookup — tokens are stateless).
PREVIEW_TOKEN_SECRET=dev-preview-token-secret-change-me

# The admin's public origin (scheme + host, no trailing slash), e.g.
# https://admin.example.com. PRODUCTION-ONLY: lets the admin iframe the public
# site for the structure editor's live preview + the Block Gallery's per-block
# previews. When unset in production, the web app sends X-Frame-Options:
# SAMEORIGIN and those iframes render blank. No effect in dev (the security
# headers are production-only). Leave blank for local Docker (same-origin).
NUXT_ADMIN_ORIGIN=

# Shared secret for the post-publish SWR cache purge: the api POSTs to the web
# container's /api/_purge with it so published edits + theme changes refresh
# cached pages immediately instead of waiting out the 300s TTL. REQUIRED on a
# production publishing site: set the SAME non-empty value on BOTH the api and
# web services. Empty (this default) is fine for local dev, but on live it means
# every published change takes up to 5 min to appear on home/stories/archive.
PURGE_SECRET=

# Optional internal URL for the web container (e.g. http://web:3001), used for
# server-to-server calls like the SWR cache purge. Set this on the API service
# when the api can't reach its own public https domain (common on Coolify/Docker
# "hairpin" NAT) — the purge then goes over the internal network instead of the
# public Site URL, which otherwise makes it time out silently. Empty → the api
# uses the public Site URL from Site Settings.
WEB_INTERNAL_URL=

# Master key for encrypting webhook signing secrets at rest (AES-256-GCM,
# derived via scrypt). Must be ≥32 chars in NODE_ENV=production. Rotating
# this invalidates every stored encrypted secret — operators must use the
# admin "Rotate secret" flow on each webhook afterwards.
WEBHOOK_SECRET_ENCRYPTION_KEY=dev-webhook-secret-encryption-key-change-me

# ─── Email (review notifications) ──────────────────────────────────────────────
# stub        — log emails to worker stdout (default; safe for local dev)
# smtp        — nodemailer + SMTP_* below
# resend      — Resend HTTPS API (RESEND_API_KEY)
# sendinblue  — Brevo / SendinBlue HTTPS API (SENDINBLUE_API_KEY)
# http        — generic Resend-shape POST to EMAIL_HTTP_* (Mailgun JSON,
#               Postmark, MailerSend, or a custom forwarder)
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@cms.local

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

RESEND_API_KEY=
SENDINBLUE_API_KEY=

# Generic HTTP transport — endpoint receives Resend-shape JSON body
# {from, to, subject, html, text}. EMAIL_HTTP_AUTH_VALUE is sent verbatim
# as the EMAIL_HTTP_AUTH_HEADER (e.g. "Bearer xxx" for Authorization).
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_AUTH_HEADER=Authorization
EMAIL_HTTP_AUTH_VALUE=
EMAIL_HTTP_METHOD=POST
EMAIL_HTTP_CONTENT_TYPE=application/json

# ─── Worker (apps/worker) ──────────────────────────────────────────────────────
# Per-queue concurrency. Image processing is CPU-bound via Sharp (libvips is
# multi-threaded internally — keep this low on small VMs). The rest are I/O-bound.
WORKER_IMAGE_CONCURRENCY=2
WORKER_WEBHOOK_CONCURRENCY=16
WORKER_SEARCH_INDEX_CONCURRENCY=8
WORKER_SCHEDULE_PUBLISH_CONCURRENCY=4
WORKER_EMAIL_CONCURRENCY=4
