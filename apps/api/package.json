{
  "name": "@cms/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify backend API for the CMS",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "seed:test-admin": "tsx --env-file=../../.env scripts/seed-test-admin.ts",
    "seed:admin": "tsx --env-file=../../.env scripts/seed-admin.ts",
    "seed:examples": "tsx --env-file=../../.env scripts/seed-examples.ts",
    "seed:fixtures": "tsx --env-file=../../.env scripts/seed-fixtures.ts",
    "verify:fixtures": "tsx scripts/verify-fixtures.ts",
    "seed:menus": "tsx --env-file=../../.env scripts/seed-menus.ts",
    "fold:single-tenant": "tsx --env-file=../../.env scripts/fold-to-single-tenant.ts",
    "wipe:content": "tsx --env-file=../../.env scripts/wipe-content.ts",
    "prune:content-types": "tsx --env-file=../../.env scripts/prune-content-types.ts",
    "audit:prune": "tsx --env-file=../../.env scripts/audit-prune.ts",
    "meili:reindex": "tsx --env-file=../../.env scripts/meili-reindex.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@bull-board/api": "^6.5.0",
    "@bull-board/fastify": "^6.5.0",
    "@cms/admin-guide": "workspace:*",
    "@cms/blocks": "workspace:*",
    "@cms/config": "workspace:*",
    "@cms/db": "workspace:*",
    "@cms/editor": "workspace:*",
    "@cms/email": "workspace:*",
    "@cms/queue": "workspace:*",
    "@cms/search": "workspace:*",
    "@cms/types": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^7.120.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.58.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.15",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
