# Integration test environment. Loaded by test/integration-setup.ts via
# process.loadEnvFile BEFORE any @cms/* import — @cms/config validates env
# at module load, so this must happen first.
#
# Assumes `docker compose up -d` and one-time `createdb -h localhost -U postgres cms_test`.

NODE_ENV=test
LOG_LEVEL=warn

# Direct (non-pooled) Postgres for tests: avoids pgbouncer transaction-mode
# constraints (SELECT FOR UPDATE, advisory locks) and gives explicit control.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cms_test
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cms_test

# Redis logical db 15 — isolated from dev queues in db 0. Setup runs FLUSHDB
# scoped to db 15 only. NEVER FLUSHALL.
REDIS_URL=redis://localhost:6379/15

MEILI_HOST=http://localhost:7700

# Dedicated test bucket; setup creates it if missing.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Deterministic ≥32 chars so encrypted webhook secrets are reproducible run-to-run.
WEBHOOK_SECRET_ENCRYPTION_KEY=test-webhook-encryption-key-do-not-use-in-prod-32chars
PREVIEW_TOKEN_SECRET=test-preview-token-secret-do-not-use-in-prod-32chars

PUBLIC_TENANT_SLUG=test-tenant

# Default to stub so any test that forgets to override doesn't hang trying to
# reach an SMTP host or call out to Resend/Brevo.
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@test.local
