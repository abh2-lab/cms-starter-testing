{
  "name": "@cms/email",
  "version": "0.0.0",
  "private": true,
  "description": "Email transport layer (provider config + send), shared by the API (synchronous test send) and the worker (queue-driven notification email)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@cms/config": "workspace:*",
    "@cms/db": "workspace:*",
    "@cms/queue": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
