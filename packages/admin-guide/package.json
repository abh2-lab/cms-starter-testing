{
  "name": "@cms/admin-guide",
  "version": "0.0.0",
  "private": true,
  "description": "Shared admin operator help content + navigation map (consumed by the admin help drawer and the AI assistant)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
