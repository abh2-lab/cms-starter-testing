# Claude Code — track team-shared policy (settings.json, hooks/) but ignore
# per-machine artifacts: skill symlinks, ephemeral worktrees, local overrides.
.claude/skills/
.claude/worktrees/
.claude/settings.local.json

# Skills installer artifacts (antfu/skills) — local install of skill bundles
.agents/
skills-lock.json

# Generated by packages/blocks/scripts/gen-registry.mjs at build time.
# Derived from the files in src/{blocks,templates,parts} — committing it would
# reintroduce the shared hand-edited file the codegen exists to remove.
packages/blocks/src/generated-modules.ts
